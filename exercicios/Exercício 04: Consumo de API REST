"""
Exercício 04: Consumo de API REST pública (ViaCEP)
Objetivo: Fazer uma requisição HTTP, receber JSON e extrair informações úteis.
"""

import urllib.request
import json

def consultar_cep(cep):
    cep_limpo = cep.replace("-", "").strip()
    url = f"https://viacep.com.br/ws/{cep_limpo}/json/"
    
    try:
        requisicao = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
        with urllib.request.urlopen(requisicao) as resposta:
            dados = json.loads(resposta.read().decode('utf-8'))
            
            if "erro" in dados:
                return "CEP não localizado na base."
                
            return {
                "Logradouro": dados.get("logradouro"),
                "Bairro": dados.get("bairro"),
                "Cidade": dados.get("localidade"),
                "UF": dados.get("uf")
            }
    except Exception as e:
        return f"Falha na consulta: {e}"

if __name__ == "__main__":
    resultado = consultar_cep("01310-100")  # Av. Paulista
    print("Resultado da consulta de API:")
    print(resultado)
